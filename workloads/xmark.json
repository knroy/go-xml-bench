{
  "id": "xmark",
  "area": "xquery",
  "description": "XMark q1..q20 over the auction documents at factors 0.01 and 0.1 (about 1 and 11 MB); factor 1 (111 MB) is excluded because go-xml's CLI refuses a document over xdm.DefaultMaxBytes (64 MB) and has no flag to raise it; the auction document is the context item (testdata/bench/SOURCES.md). Outputs agree byte-for-byte after whitespace collapse; BaseX is told to serialize with the XML output method and an XML declaration, as go-xml and Saxon do by default, instead of its own newline-separated method.",
  "inputs": "testdata/bench/xmark/",
  "normalise": "whitespace",
  "engines": [
    "go-xml",
    "saxon-he",
    "basex"
  ],
  "modes": [
    "cold",
    "warm"
  ],
  "args": {
    "basex": [
      "-smethod=xml",
      "-somit-xml-declaration=no"
    ]
  },
  "items": [
    {
      "name": "q1",
      "query": "testdata/bench/xmark/queries/q1.xq",
      "glob": "testdata/bench/xmark/auction-0.*.xml"
    },
